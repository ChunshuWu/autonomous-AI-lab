# Publish source only; this folder also contains private research.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/package.json
!/.github/
!/docs/
!/config/
!/scripts/
!/site/
!/skill/
!/examples/
!/runtime/
/examples/*
!/examples/missing-measurements/
/runtime/*
!/runtime/task-service/
!/runtime/library/
/runtime/task-service/*
!/runtime/task-service/*.py
/runtime/library/*
!/runtime/library/*.py
!/runtime/library/requirements.txt

# Private hosting settings and legacy research seeds.
/site/.openai/
/site/seed.json
/site/library-seed.json
/site/generated.mjs
/site/index.mjs
/site/dist/

# Local credentials, environments and generated files.
.env
.env.*
!.env.example
.wulab/
connection.json
credentials.json
auth.json
*.sqlite*
*.log
*.tmp
*.tar.gz
__pycache__/
*.pyc
.venv/
node_modules/
.DS_Store
docs/screenshots/*.tmp.png
